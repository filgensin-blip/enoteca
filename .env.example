# All optional for the first deploy: without RESEND_API_KEY the booking form still works,
# logs every booking as "[BOOKING]" in the Netlify function log, and asks the guest to call.
RESEND_API_KEY=            # Resend API key (resend.com → API Keys)
BOOKING_FROM_EMAIL="Enoteca Ombra <onboarding@resend.dev>"   # needs a verified domain for real guests
CAFE_NOTIFICATION_EMAIL=   # inbox that receives new bookings, e.g. ciao@enoteca-ombra.nl
NEXT_PUBLIC_SITE_URL=      # e.g. https://enoteca-ombra.netlify.app — falls back to Netlify's URL env var
